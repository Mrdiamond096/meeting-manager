POSTGRES_USER=meeting
POSTGRES_PASSWORD=meeting
POSTGRES_DB=meeting
WEB_PORT=8080
DB_PORT=5432

# API (local demo). Origins allowed on non-GET requests; keep in sync with WEB_PORT.
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
LOG_LEVEL=info
# Registrations per IP as max/minutes. ADR-013 is 3/60; raised for demos, where one machine registers many accounts.
RATE_LIMIT_REGISTER=100/60
# Demo OTP accepted by the mock provider (no real email/SMS is sent).
OTP_MOCK_CODE=112233
