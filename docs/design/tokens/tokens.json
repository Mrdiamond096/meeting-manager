{
  "$description": "Candidate Meeting Scheduler — Theme 'Lagoon'. Source of truth สำหรับสร้าง Figma Variables (collection: color, modes: light/dark) ค่าต้องตรงกับ globals.css",
  "color": {
    "background":              { "light": "#F7F8FA", "dark": "#0E131A" },
    "foreground":              { "light": "#141A24", "dark": "#E8ECF1" },
    "card":                    { "light": "#FFFFFF", "dark": "#151B24" },
    "card-foreground":         { "light": "#141A24", "dark": "#E8ECF1" },
    "primary":                 { "light": "#1F7A6D", "dark": "#3FB8A6" },
    "primary-foreground":      { "light": "#FFFFFF", "dark": "#06201C" },
    "brand":                   { "light": "#F4B23E", "dark": "#F4B23E" },
    "brand-foreground":        { "light": "#1F2937", "dark": "#1F2937" },
    "secondary":               { "light": "#EEF1F5", "dark": "#1D2530" },
    "secondary-foreground":    { "light": "#1F2937", "dark": "#E8ECF1" },
    "muted":                   { "light": "#EEF1F5", "dark": "#1D2530" },
    "muted-foreground":        { "light": "#5F6B7A", "dark": "#93A0B0" },
    "accent":                  { "light": "#E8F3F1", "dark": "#16302C" },
    "accent-foreground":       { "light": "#134E46", "dark": "#B8ECE3" },
    "border":                  { "light": "#E3E6EB", "dark": "#263040" },
    "input":                   { "light": "#D5DAE1", "dark": "#2E3A4C" },
    "ring":                    { "light": "#1F7A6D", "dark": "#3FB8A6" },
    "success":                 { "light": "#1E6B3A", "dark": "#6FCF8F" },
    "success-subtle":          { "light": "#E6F4EA", "dark": "#12301D" },
    "warning":                 { "light": "#8A5A00", "dark": "#F4C26B" },
    "warning-subtle":          { "light": "#FDF3DC", "dark": "#332508" },
    "destructive":             { "light": "#B42318", "dark": "#F2867A" },
    "destructive-subtle":      { "light": "#FDECEA", "dark": "#3A1512" },
    "destructive-foreground":  { "light": "#FFFFFF", "dark": "#1A0503" },
    "info":                    { "light": "#475467", "dark": "#B4BFCC" },
    "info-subtle":             { "light": "#EEF1F5", "dark": "#1D2530" }
  },
  "radius":  { "sm": 6, "md": 8, "lg": 10, "xl": 16, "full": 9999 },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48 },
  "font": {
    "family": { "sans": "Inter, IBM Plex Sans Thai", "mono": "JetBrains Mono" },
    "size":   { "xs": 12, "sm": 14, "base": 16, "lg": 18, "xl": 20, "2xl": 24, "3xl": 30 },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "shadow": {
    "card":   "0 1px 2px rgba(20,26,36,0.04), 0 1px 3px rgba(20,26,36,0.06)",
    "popover":"0 8px 24px rgba(20,26,36,0.12)"
  }
}
